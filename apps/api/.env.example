# Porta HTTP em que o backend escuta (padrao: 3333).
PORT=3333

# Ambiente de execucao: development | test | production.
NODE_ENV=development

# Conexao com o PostgreSQL (obrigatoria para subir o servidor).
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/cad_web

# Segredo para assinar os tokens JWT (obrigatorio; >= 32 caracteres em producao).
JWT_SECRET=troque-este-segredo

# Origens permitidas no CORS, separadas por virgula. Ausente reflete a origem (dev).
# CORS_ORIGINS=https://app.suaempresa.com,https://admin.suaempresa.com

# Nivel de log do pino: trace | debug | info | warn | error | fatal (padrao: info).
LOG_LEVEL=info

# Conexao com o Redis (reservado para cache/filas; ainda nao utilizado).
# REDIS_URL=redis://127.0.0.1:6379
