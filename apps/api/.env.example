# Porta HTTP em que o backend escuta (padrao: 3333).
PORT=3333

# Ambiente de execucao: development | test | production.
NODE_ENV=development

# Conexao com o PostgreSQL (obrigatoria para subir o servidor).
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/cad_web

# Segredo para assinar os tokens JWT (obrigatorio; use um valor forte e secreto).
JWT_SECRET=troque-este-segredo
