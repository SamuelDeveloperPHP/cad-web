{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@cad-web/cad-core": [
        "packages/cad-core/src/index.ts"
      ],
      "@cad-web/cad-geometry": [
        "packages/cad-geometry/src/index.ts"
      ],
      "@cad-web/cad-renderer": [
        "packages/cad-renderer/src/index.ts"
      ],
      "@cad-web/cad-tools": [
        "packages/cad-tools/src/index.ts"
      ],
      "@cad-web/cad-io": [
        "packages/cad-io/src/index.ts"
      ]
    },
    "strict": true,
    "composite": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "useDefineForClassFields": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
